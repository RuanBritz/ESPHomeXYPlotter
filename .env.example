# Copy to .env to override the defaults (loaded automatically by npm start).
# Interface for the web UI. 0.0.0.0 = reachable from your LAN (phone/tablet); 127.0.0.1 = this computer only.
HOST=0.0.0.0
PORT=3000
# Which plotter addresses the server may connect to: private (LAN/loopback only), any, or a comma list of hosts.
ALLOWED_TARGETS=private
# Give up waiting for "ok" after this long. Slow, long moves can legitimately take minutes.
LINE_TIMEOUT_MS=300000
CONNECT_TIMEOUT_MS=5000
MAX_UPLOAD_MB=50
# --- MCP server (npm run mcp) ---
# Where the MCP server finds the web server's API. Default: http://127.0.0.1:<PORT>
# PLOTTER_URL=http://127.0.0.1:3000
# Pen commands and drawing feed (mm/min) used by the draw_polylines tool.
# PEN_UP=M5
# PEN_DOWN=M3 S1000
# DRAW_FEED=3000
