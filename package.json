{
  "name": "esphome-xy-plotter",
  "version": "2.0.0",
  "description": "Web UI for streaming G-code to an ESP32 XY pen plotter over TCP",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "simulator": "node tools/grbl-simulator.js",
    "mcp": "node src/mcp/server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "license": "MIT"
}
