{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "running at (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Start server (auto-restart on changes)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "runtimeArgs": ["--watch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "GRBL simulator (no hardware)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/grbl-simulator.js",
      "args": ["1234"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "test/*.test.js"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Server + simulator",
      "configurations": ["GRBL simulator (no hardware)", "Start server"],
      "stopAll": true
    }
  ]
}
